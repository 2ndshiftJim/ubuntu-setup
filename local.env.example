# Copy to local.env (gitignored) and fill in. Do NOT commit real values or tokens.
# Read by install.sh, the scripts/ tools and (copied to ~/.config/machine-setup/) your shells.

# Which profiles (profiles/NAME or gitignored profiles.local/NAME) this machine uses,
# comma-separated. Empty = base only. See profiles/README.md.
# PROFILES="k8s,dev"

# SSH key file names under ~/.ssh for keychain to attach (space-separated). Empty = none.
# SSH_KEYS="id_ed25519_<purpose>"

# Kubernetes apt minor stream, if this machine uses the 'kubernetes' repo (match your cluster).
# K8S_MINOR="v1.37"

# Set to 0 to skip cloning kickstart.nvim.
# KICKSTART=0

# Anything else for your shells, e.g.:
# export VAULT_ADDR="https://vault.example.invalid"
# export VAULT_NAMESPACE=""
